<Window x:Class="RugScale.Workbench.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RugScale Workbench"
        Width="1580" Height="920"
        MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#202124" Foreground="#F1F1F1">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <Button Content="Open indexed BMP" Click="OnOpen" Padding="12,6" Margin="0,0,6,0"/>
                <Button Content="Save preview" Click="OnSave" Padding="12,6" Margin="0,0,14,0"/>
                <TextBlock Text="RugScale Workbench" FontSize="20" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="FileText" DockPanel.Dock="Right" HorizontalAlignment="Right"
                       VerticalAlignment="Center" Foreground="#BFC5CC" TextTrimming="CharacterEllipsis"/>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#292B2F" CornerRadius="6" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Scale settings" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <TextBlock Text="Mode"/>
                        <ComboBox x:Name="ModeCombo" SelectedIndex="0" Margin="0,4,0,10">
                            <ComboBoxItem Content="RugScale — motif &amp; topology" Tag="motif"/>
                            <ComboBoxItem Content="Curve &amp; Fill" Tag="curve-fill"/>
                            <ComboBoxItem Content="Leaf / Petal Arcs" Tag="leaf-petal"/>
                            <ComboBoxItem Content="Nearest Neighbor" Tag="nearest"/>
                            <ComboBoxItem Content="Preserve Detail" Tag="preserve-detail"/>
                            <ComboBoxItem Content="Dominant" Tag="dominant"/>
                            <ComboBoxItem Content="Edge Smooth" Tag="edge-smooth"/>
                            <ComboBoxItem Content="Smooth" Tag="smooth"/>
                            <ComboBoxItem Content="Area Average" Tag="area-average"/>
                        </ComboBox>

                        <TextBlock Text="Target pixels"/>
                        <UniformGrid Columns="2" Margin="0,4,0,10">
                            <StackPanel Margin="0,0,4,0">
                                <TextBlock Text="Width" Foreground="#AEB4BC"/>
                                <TextBox x:Name="WidthBox" Text="640"/>
                            </StackPanel>
                            <StackPanel Margin="4,0,0,0">
                                <TextBlock Text="Height" Foreground="#AEB4BC"/>
                                <TextBox x:Name="HeightBox" Text="1150"/>
                            </StackPanel>
                        </UniformGrid>

                        <TextBlock Text="Source quality (warp / weft)"/>
                        <UniformGrid Columns="2" Margin="0,4,0,10">
                            <TextBox x:Name="SourceWarpBox" Text="40" Margin="0,0,4,0"/>
                            <TextBox x:Name="SourceWeftBox" Text="50" Margin="4,0,0,0"/>
                        </UniformGrid>

                        <TextBlock Text="Target quality (warp / weft)"/>
                        <UniformGrid Columns="2" Margin="0,4,0,12">
                            <TextBox x:Name="TargetWarpBox" Text="40" Margin="0,0,4,0"/>
                            <TextBox x:Name="TargetWeftBox" Text="50" Margin="4,0,0,0"/>
                        </UniformGrid>

                        <Button Content="Run / refresh preview" Click="OnRun"
                                Padding="12,7" FontWeight="SemiBold" Margin="0,0,0,14"/>

                        <Separator Margin="0,2,0,12"/>

                        <TextBlock Text="Preview navigation" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Zoom" Margin="0,8,0,2"/>
                        <Slider x:Name="ZoomSlider" Minimum="0.25" Maximum="4" Value="1"
                                TickFrequency="0.25" IsSnapToTickEnabled="False"
                                ValueChanged="OnZoomChanged"/>
                        <TextBlock x:Name="ZoomText" Text="100%" Foreground="#BFC5CC" Margin="0,2,0,10"/>

                        <CheckBox x:Name="SquareSelectionCheck" Content="Square selection"
                                  IsChecked="False" Margin="0,0,0,8"/>
                        <TextBlock Text="Drag on the result image to define the active selection. Scrollbars pan the design."
                                   TextWrapping="Wrap" Foreground="#AEB4BC"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#151617" CornerRadius="6" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Original source" FontWeight="SemiBold" Margin="2,0,0,6"/>
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto" Background="#383A3D">
                            <Image x:Name="SourceImage" Stretch="None"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Background="#151617" CornerRadius="6" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="2,0,0,6">
                            <TextBlock Text="Result / training canvas" FontWeight="SemiBold"/>
                            <TextBlock x:Name="SelectionInfoText" DockPanel.Dock="Right"
                                       HorizontalAlignment="Right" Foreground="#AFC7FF"/>
                        </DockPanel>
                        <ScrollViewer Grid.Row="1" x:Name="PreviewScroll"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      Background="#383A3D">
                            <Grid x:Name="PreviewHost" HorizontalAlignment="Left" VerticalAlignment="Top">
                                <Image x:Name="PreviewImage" Stretch="Fill"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                <Canvas x:Name="PreviewOverlay" Background="Transparent"
                                        MouseLeftButtonDown="OnPreviewMouseDown"
                                        MouseMove="OnPreviewMouseMove"
                                        MouseLeftButtonUp="OnPreviewMouseUp">
                                    <Rectangle x:Name="SelectionRect"
                                               Stroke="#FF4FA3FF" StrokeThickness="2"
                                               Fill="#304FA3FF" Visibility="Collapsed"
                                               IsHitTestVisible="False"/>
                                </Canvas>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Column="4" Background="#292B2F" CornerRadius="6" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Motif training" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Text="This workbench owns RugScale feedback; it does not use RugCAD drawing tools."
                                   TextWrapping="Wrap" Foreground="#AEB4BC" Margin="0,4,0,12"/>

                        <WrapPanel>
                            <Button Content="Select broken motif" Click="OnSelectMotif" Padding="8,4" Margin="0,0,5,5"/>
                            <Button Content="Select target" Click="OnSelectTarget" Padding="8,4" Margin="0,0,5,5"/>
                            <Button Content="Use detected area" Click="OnUseDetectedTarget" Padding="8,4" Margin="0,0,5,5"/>
                        </WrapPanel>

                        <Button x:Name="DetectButton" Content="1. Detect motif"
                                Click="OnDetectMotif" Padding="10,6" Margin="0,6,0,6"
                                IsEnabled="False" FontWeight="SemiBold"/>
                        <Button x:Name="RepairButton" Content="2. Preview repair"
                                Click="OnPreviewRepair" Padding="10,6" Margin="0,0,0,10"
                                IsEnabled="False" FontWeight="SemiBold"/>

                        <Border Background="#3A3C40" BorderBrush="#62666D" BorderThickness="1"
                                Padding="6" MinHeight="180">
                            <Image x:Name="MotifImage" Stretch="Uniform" MaxHeight="250"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        </Border>
                        <TextBlock x:Name="CandidateText" Text="No motif detected."
                                   TextWrapping="Wrap" Margin="0,8,0,8"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="◀ Previous" Click="OnPreviousCandidate" Padding="8,4" Margin="0,0,6,0"/>
                            <Button Content="Next ▶" Click="OnNextCandidate" Padding="8,4"/>
                        </StackPanel>

                        <TextBlock x:Name="RedrawText" Text="Redraw: not previewed yet"
                                   Foreground="#AFC7FF" FontWeight="SemiBold" Margin="0,10,0,8"
                                   TextWrapping="Wrap"/>

                        <WrapPanel HorizontalAlignment="Center">
                            <Button x:Name="GoodButton" Content="✓ Good / learn" Click="OnGood"
                                    IsEnabled="False" Padding="9,5" Margin="0,0,5,5"/>
                            <Button x:Name="BadButton" Content="↻ Bad / improve" Click="OnBad"
                                    IsEnabled="False" Padding="9,5" Margin="0,0,5,5"/>
                            <Button x:Name="DifferentButton" Content="Different source" Click="OnDifferentSource"
                                    IsEnabled="False" Padding="9,5" Margin="0,0,5,5"/>
                        </WrapPanel>

                        <Separator Margin="0,10,0,10"/>
                        <WrapPanel>
                            <Button Content="Import memory" Click="OnImportMemory" Padding="8,4" Margin="0,0,5,5"/>
                            <Button Content="Export memory" Click="OnExportMemory" Padding="8,4" Margin="0,0,5,5"/>
                        </WrapPanel>
                        <TextBlock x:Name="MemoryText" Foreground="#AEB4BC"
                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#292B2F" CornerRadius="4" Padding="8" Margin="0,8,0,0">
            <TextBlock x:Name="StatusText" Text="Open an 8-bit indexed BMP to begin."
                       TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>
